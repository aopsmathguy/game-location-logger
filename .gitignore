# Bundle cache: survev re-hashes its bundle filenames on every deploy, so this
# directory is fully replaced each fetch. It is a cache, not source — the
# webapp repopulates it via tools/fetch_survev_js.py.
js_dump/

# derive_mangled.py's last-known-good backup of extension/core/mangled.js.
*.bak

node_modules/
.ruff_cache/
.DS_Store
