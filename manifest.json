{
  "manifest_version": 3,
  "minimum_chrome_version": "111",
  "name": "survev.io game-state toolkit",
  "version": "0.3.0",
  "description": "Reads survev.io's live in-memory game state: enemy ESP overlay, aim helper, auto-quickswap, netcode smoothing, ping readout, and a JSON position log.",
  "permissions": [
    "downloads"
  ],
  "host_permissions": [
    "*://survev.io/*",
    "*://*.survev.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Export position log"
  },
  "content_scripts": [
    {
      "matches": [
        "*://survev.io/*",
        "*://*.survev.io/*"
      ],
      "js": [
        "mangled.js",
        "inject.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://survev.io/*",
        "*://*.survev.io/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
